{
  "number": 1,
  "name": "Al-Fatiha",
  "arabic_name": "الفاتحة",
  "verses": [
    {
      "ayah": 1,
      "arabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
      "bangla": "পরম করুণাময় অতি দয়ালু আল্লাহর নামে।"
    },
    {
      "ayah": 2,
      "arabic": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ",
      "bangla": "সমস্ত প্রশংসা আল্লাহর জন্য, যিনি সকল সৃষ্টির পালনকর্তা।"
    }
  ]
